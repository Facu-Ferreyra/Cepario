{
  "$id": "https://facu-ferreyra.github.io/Cepario/schema/fuentes.schema.json",
  "title": "Fuentes de Cepario",
  "description": "Archivo data/fuentes.json: cada clave es una fuente con su licencia. Generado desde src/lib/esquema.ts.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comentario": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "nombre": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "url": {
        "type": "string",
        "pattern": "^https:\\/\\/"
      },
      "licencia": {
        "type": "string",
        "enum": [
          "ODbL-1.0",
          "DbCL-1.0",
          "PDDL-1.0",
          "CC0-1.0",
          "CC-BY-4.0",
          "MIT"
        ],
        "description": "Solo licencias compatibles con publicar bajo ODbL. Nada de \"todos los derechos reservados\"."
      },
      "fecha": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Fecha de los datos (AAAA-MM-DD)."
      },
      "copyright": {
        "type": "string",
        "maxLength": 200
      },
      "nota": {
        "type": "string",
        "maxLength": 300
      }
    },
    "required": [
      "nombre",
      "url",
      "licencia",
      "fecha"
    ],
    "additionalProperties": false
  }
}
