{
  "$id": "https://facu-ferreyra.github.io/Cepario/schema/aporte.schema.json",
  "title": "Aporte de Cepario",
  "description": "Archivo data/aportes/<slug>.json: solo los campos aportados, cada uno con su fuente. Generado desde src/lib/esquema.ts; reglas extra en scripts/validate.mjs.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comentario": {
      "description": "Nota para quien revisa. No se publica.",
      "type": "string"
    },
    "nombre": {
      "description": "Solo para variedades nuevas (slug que no existe).",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "criador": {
      "type": "object",
      "properties": {
        "valor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    },
    "tipo": {
      "type": "object",
      "properties": {
        "valor": {
          "type": "string",
          "enum": [
            "hibrida",
            "indica",
            "sativa"
          ]
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    },
    "genetica": {
      "type": "object",
      "properties": {
        "valor": {
          "type": "object",
          "properties": {
            "indica": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "sativa": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "indica",
            "sativa"
          ],
          "additionalProperties": false
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    },
    "thc": {
      "type": "object",
      "properties": {
        "valor": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 40
                },
                "max": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 40
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false,
      "description": "THC en %: número o rango {min, max}, entre 0 y 40."
    },
    "cbd": {
      "type": "object",
      "properties": {
        "valor": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 30
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                },
                "max": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false,
      "description": "CBD en %: número o rango {min, max}, entre 0 y 30."
    },
    "floracion": {
      "type": "object",
      "properties": {
        "valor": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 4,
              "maximum": 20
            },
            {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 20
                },
                "max": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 20
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          ]
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false,
      "description": "Floración en semanas: número o rango {min, max}, entre 4 y 20."
    },
    "sabores": {
      "type": "object",
      "properties": {
        "valor": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    },
    "efectos": {
      "type": "object",
      "properties": {
        "valor": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    },
    "adversos": {
      "type": "object",
      "properties": {
        "valor": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    },
    "terpenos": {
      "type": "object",
      "properties": {
        "valor": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    },
    "antocianinas": {
      "type": "object",
      "properties": {
        "valor": {
          "type": "string",
          "enum": [
            "alta",
            "media",
            "baja"
          ]
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false,
      "description": "Tendencia a violeta (antocianinas). Define el color del modelo 3D."
    },
    "padres": {
      "type": "object",
      "properties": {
        "valor": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "fuente": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "valor",
        "fuente"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
