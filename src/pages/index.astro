// Portada: la lámina de la variedad del día.
import Lamina from '../layouts/Lamina.astro';
import PaginaVariedad from '../components/PaginaVariedad.astro';
import { catalogo } from '../lib/catalogo.ts';

const c = await catalogo();
---
<Lamina titulo="Cepario, atlas de variedades de cannabis" descripcion="Catálogo informativo de variedades de cannabis con visor 3D. Datos con fuente y licencia en cada ficha.">
  <!-- Enlaces de la versión anterior (/Cepario/#slug): se redirigen a la página de la variedad -->
  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>
    const slug = decodeURIComponent(location.hash.slice(1));
    if (/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug)) location.replace(`${base}v/${slug}/`);
  </script>
  <PaginaVariedad v={c.delDia} />
</Lamina>
