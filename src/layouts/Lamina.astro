---
// Copyright 2026 Facundo Agustín Ferreyra
// SPDX-License-Identifier: Apache-2.0

// Layout común a todas las páginas: <head>, tipografías, tema, íconos y el aviso de edad.
// Lo que va entre los "---" corre en el build (Node), nunca en el navegador.
import '../styles/tokens.css';
import '../styles/lamina.css';

interface Props {
  titulo: string;
  descripcion: string;
}
const { titulo, descripcion } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{titulo}</title>
    <meta name="color-scheme" content="light dark">
    <meta name="description" content={descripcion}>
    <link rel="canonical" href={canonica}>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234d5a3d' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 21v-6M12 15c-1.5-3-1.5-7 0-12 1.5 5 1.5 9 0 12zM12 15c-3-1-5.5-3.5-7-8 4 1.5 6.5 4.5 7 8zM12 15c3-1 5.5-3.5 7-8-4 1.5-6.5 4.5-7 8z'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Courier+Prime:wght@400;700&family=Gloock&display=swap" rel="stylesheet">
    <!-- Tema guardado antes de pintar, para que no haya un destello claro -->
    <script is:inline>try { const t = localStorage.getItem('cepario-tema'); if (t) document.documentElement.dataset.tema = t; } catch {}</script>
    <!-- Sin JavaScript: la etiqueta, el linaje y anterior/siguiente funcionan; lo interactivo se oculta -->
    <noscript><style>html,body{height:auto}body{overflow:auto}.hero{height:auto;min-height:100vh}.stage,.nav,#navT,.top,.closeup,#mSearch,#rand,.fsel{display:none}.card{max-height:none;overflow:visible}</style></noscript>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="i-leaf" viewBox="0 0 24 24"><path d="M12 21v-6"/><path d="M12 15c-1.5-3-1.5-7 0-12 1.5 5 1.5 9 0 12z"/><path d="M12 15c-3-1-5.5-3.5-7-8 4 1.5 6.5 4.5 7 8zM12 15c3-1 5.5-3.5 7-8-4 1.5-6.5 4.5-7 8z"/><path d="M12 15c-2.5.5-5 0-7.5-2 2.5-.5 5 .2 7.5 2zM12 15c2.5.5 5 0 7.5-2-2.5-.5-5 .2-7.5 2z"/></symbol>
        <symbol id="i-hand" viewBox="0 0 24 24"><path d="M18 11V6.5a1.5 1.5 0 0 0-3 0V11"/><path d="M15 10.5v-6a1.5 1.5 0 0 0-3 0v6"/><path d="M12 10.5v-5a1.5 1.5 0 0 0-3 0V14"/><path d="M18 8.5a1.5 1.5 0 0 1 3 0V14a7 7 0 0 1-7 7h-1.5a7 7 0 0 1-5-2.1L4 16.4a1.6 1.6 0 0 1 2.3-2.3L9 16.5"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/></symbol>
        <symbol id="i-zoomin" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4M11 8.5v5M8.5 11h5"/></symbol>
        <symbol id="i-expand" viewBox="0 0 24 24"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></symbol>
        <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></symbol>
        <symbol id="i-ccw" viewBox="0 0 24 24"><path d="M4 4v5h5"/><path d="M4.6 15A8 8 0 1 0 6.3 6.3L4 9"/></symbol>
        <symbol id="i-cw" viewBox="0 0 24 24"><path d="M20 4v5h-5"/><path d="M19.4 15A8 8 0 1 1 17.7 6.3L20 9"/></symbol>
        <symbol id="i-dice" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8.5 8.5h.01M15.5 15.5h.01M12 12h.01M15.5 8.5h.01M8.5 15.5h.01" stroke-width="2.6"/></symbol>
        <symbol id="i-chevl" viewBox="0 0 24 24"><path d="m15 6-6 6 6 6"/></symbol>
        <symbol id="i-chev" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></symbol>
        <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></symbol>
      </defs>
    </svg>

    <div class="gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gateT" hidden>
      <div class="gbox">
        <h2 id="gateT">¿Tenés 18 años o más?</h2>
        <p>Este sitio reúne información sobre variedades de cannabis con fines informativos. No es consejo médico ni promueve el consumo.</p>
        <div class="gbtns">
          <button type="button" class="primary" id="gYes">Sí, tengo 18 o más</button>
          <button type="button" id="gNo">No</button>
        </div>
        <p id="gMsg" hidden>Este contenido no está disponible para menores de edad.</p>
      </div>
    </div>

    <slot />

    <script>
      // Aviso de edad: se muestra hasta que la persona confirma; la respuesta queda guardada.
      const CLAVE = 'cepario-edad-ok';
      function avisoDeEdad(): void {
        const gate = document.getElementById('gate');
        if (!gate) return;
        let ok = false;
        try { ok = localStorage.getItem(CLAVE) === '1'; } catch { /* almacenamiento bloqueado: se vuelve a preguntar */ }
        if (ok) return;
        gate.hidden = false;
        document.getElementById('gYes')?.focus();
        document.getElementById('gYes')?.addEventListener('click', () => {
          try { localStorage.setItem(CLAVE, '1'); } catch { /* vale para esta visita */ }
          gate.hidden = true;
          document.getElementById('stage')?.focus({ preventScroll: true });
        });
        document.getElementById('gNo')?.addEventListener('click', () => {
          const msg = document.getElementById('gMsg');
          if (msg) msg.hidden = false;
        });
      }
      avisoDeEdad();
    </script>
  </body>
</html>
